<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Humanizer" Version="3.0.10" />
      <PackageReference Include="MessagePack" Version="3.1.11" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="NetCord" Version="1.0.0-beta.28" />
      <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
      <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
      <PackageReference Include="NetCord.Services" Version="1.0.0-beta.28" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Database\Statements\**\*" />
    </ItemGroup>

</Project>
